KNOT_SYNC_LOG_FORMAT=pretty
RUST_LOG=info,knot_sync=debug

KNOT_SYNC_LDAP_URL=ldaps://ldap.keycloak.svc.cluster.local:3636
KNOT_SYNC_LDAP_BIND_DN=uid=svc-dns,ou=People,dc=shtr,dc=nl
KNOT_SYNC_LDAP_PASSWORD_FILE=.secrets/ldap-password
KNOT_SYNC_LDAP_BASE_DN=ou=People,dc=shtr,dc=nl
KNOT_SYNC_LDAP_ATTRIBUTES=mailAliases,mailMaskedAddresses

KNOT_SYNC_DNS_SERVER=knot-root.knot.svc.cluster.local:5053
KNOT_SYNC_ZONE_DIR=zones
KNOT_SYNC_ZONE_POLL_SECS=30
KNOT_SYNC_TSIG_KEY_NAME=knot-sync
KNOT_SYNC_TSIG_KEY_FILE=.secrets/tsig-key
KNOT_SYNC_MX_HOST=mail.shotor.com

KNOT_SYNC_INTERVAL_SECS=900
KNOT_SYNC_MAX_DELETES=5
